<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="kuberoot"
        Arguments=""
        InstallLocation="C:\Program Files\KubeRoot Authors\KubeRoot">
    </Installer>
    <PackageInformation
        PackageName="KubeRoot"
        PackageDisplayName="KubeRoot"
        PublisherName="CN=KubeRoot Authors"
        PublisherDisplayName="KubeRoot Authors"
        Version="0.1.0.0"
        PackageDescription="Open-source cross-platform Kubernetes desktop client">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="in.kuberoot.app"
                Description="Open-source cross-platform Kubernetes desktop client"
                DisplayName="KubeRoot"
                ExecutableName="kuberoot"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>KubeRoot</DisplayName>
            <PublisherDisplayName>KubeRoot Authors</PublisherDisplayName>
            <Description>Open-source cross-platform Kubernetes desktop client</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="kuberoot.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
